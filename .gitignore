# Torneos temporales (modelos copiados, no resultados)
torneo_cruzado/
torneo_cruzado_v2/
torneo_v7/

# Training / RL outputs
checkpoints/
# Datasets BC (regenerables con generar_dataset_bc.py; pueden pesar MBs)
datasets/
# Partidas reales importadas del bridge (regenerables con
# importar_sesiones_bridge.py; datos de partidas reales, no versionar)
data/
# Ignorar el CONTENIDO de models/ (no el dir) para poder re-incluir produccion/.
models/*
# EXCEPCIÓN: los modelos curados de producción SÍ se versionan (vía Git LFS).
!models/produccion/
logs/
runs/
tensorboard/
wandb/
results/
artifacts/
vecnormalize/

# Local config / secrets
.env
.env.*
*.key
*.pem

videos/
# Captura visión: salida cruda del agrupado (regenerable)
calibracion/hearts_app/*_descubiertos/
calibracion/hearts_app/*_descubiertas/
datos/capturas/

# Recursos extraidos de la APK (no redistribuir; regenerables)
# OJO: las plantillas derivadas que usa el código se versionan en
# calibracion/hearts_app/ (banners, cartas, cartas_completas). Aquí solo se ignora
# el volcado crudo de la APK (sprites originales, drawable, layouts, raw, ...).
calibracion/Corazones/

# Android platform-tools (ADB): binarios grandes, descargables aparte
herramientas/
platform-tools.zip
